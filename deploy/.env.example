# Copy to .env on the server (cp .env.example .env; chmod 600 .env) and fill in. Never commit the real one.
# Passwords: make them long and random, e.g.  openssl rand -hex 24   (letters and digits only; never use ' " $ \ | & or
# spaces). deploy/README.md has commands that fill these in for you. Change the two database passwords only before the
# first deploy: Postgres keeps the one it was created with.

# The address people use. The app is at https://<DOMAIN>, sign-in at https://auth.<DOMAIN>; both need a DNS record
# pointing at this server.
DOMAIN=dnddms.com
# Let's Encrypt writes here about expiring certificates.
ACME_EMAIL=

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Who may open Keycloak's admin console (https://auth.<DOMAIN>/admin): your own public IP address, or several separated
# by spaces. 127.0.0.1 means nobody. Put your IP here only while you need the console (see deploy/README.md).
ADMIN_IPS=127.0.0.1

# Outgoing email (verification, password reset, invitations). DigitalOcean blocks outgoing connections on ports 25, 465 and
# 587, so use a service that accepts mail on another port: Resend does, on 2587 (STARTTLS). The username is the word
# "resend" and the password is an API key. Keycloak keeps its own copy of these settings after its first start; see
# "Changing the mail settings afterwards" in deploy/README.md.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=
# The sender, on a domain verified with the mail service (their SPF/DKIM records), e.g. noreply@dnddms.com
MAIL_FROM=

# Optional: log in to the container registry when pulling images. Needed only while the images are private; making the
# packages public on GitHub is simpler.
GHCR_USER=
GHCR_TOKEN=

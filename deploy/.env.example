# Copy to .env on the server (cp .env.example .env; chmod 600 .env) and fill in. Never commit the real one.
# Passwords: make them long and random, e.g.  openssl rand -base64 24   (avoid ' " $ \ and spaces)

# The address people use. The app is at https://<DOMAIN>, sign-in at https://auth.<DOMAIN>; both need a DNS record
# pointing at this server.
DOMAIN=dnddms.com
# Let's Encrypt writes here about expiring certificates.
ACME_EMAIL=

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Who may open Keycloak's admin console (https://auth.<DOMAIN>/admin): your own public IP address, or several separated
# by spaces. 127.0.0.1 means nobody, and the console is then reached through an SSH tunnel instead (see README).
ADMIN_IPS=127.0.0.1

# Outgoing email (verification, password reset, invitations), from any SMTP service: Brevo, Mailgun, Resend, ...
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender, on a domain you have set up with the mail service (their SPF/DKIM records), e.g. noreply@dnddms.com
MAIL_FROM=

# Optional: log in to the container registry when pulling images. Needed only while the images are private; making the
# packages public on GitHub is simpler.
GHCR_USER=
GHCR_TOKEN=

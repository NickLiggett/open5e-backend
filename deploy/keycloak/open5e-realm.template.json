{
  "realm": "open5e",
  "displayName": "Initiative Tracker",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(10)",
  "sslRequired": "external",
  "accessTokenLifespan": 3600,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${MAIL_FROM}",
    "fromDisplayName": "Initiative Tracker",
    "auth": "true",
    "user": "${SMTP_USERNAME}",
    "password": "${SMTP_PASSWORD}",
    "ssl": "false",
    "starttls": "true"
  },
  "clients": [
    {
      "clientId": "initiative-tracker",
      "name": "Initiative Tracker (the web app)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://${DOMAIN}/*"
      ],
      "webOrigins": [
        "https://${DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "open5e-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "open5e-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}

{
  "realm": "open5e",
  "displayName": "Open5e (local development)",
  "enabled": true,
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "open5e-cli",
      "name": "Open5e local clients (curl, Postman, a local frontend)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "open5e-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "open5e-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dm",
      "email": "dm@example.com",
      "emailVerified": true,
      "firstName": "Dungeon",
      "lastName": "Master",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dm", "temporary": false }]
    },
    {
      "username": "player",
      "email": "player@example.com",
      "emailVerified": true,
      "firstName": "Party",
      "lastName": "Player",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "player", "temporary": false }]
    },
    {
      "username": "stranger",
      "email": "stranger@example.com",
      "emailVerified": true,
      "firstName": "Some",
      "lastName": "Stranger",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "stranger", "temporary": false }]
    }
  ]
}

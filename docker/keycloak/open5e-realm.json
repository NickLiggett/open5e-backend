{
  "realm": "open5e",
  "displayName": "Open5e (local development)",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 3600,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@open5e.local",
    "fromDisplayName": "Open5e",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "open5e-cli",
      "name": "Open5e local clients (curl, Postman, a local frontend)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "open5e-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "open5e-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "initiative-tracker",
      "name": "Initiative Tracker (the web app)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:*"
      },
      "protocolMappers": [
        {
          "name": "open5e-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "open5e-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dm",
      "email": "dm@example.com",
      "emailVerified": true,
      "firstName": "Dungeon",
      "lastName": "Master",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dm", "temporary": false }]
    },
    {
      "username": "player",
      "email": "player@example.com",
      "emailVerified": true,
      "firstName": "Party",
      "lastName": "Player",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "player", "temporary": false }]
    },
    {
      "username": "stranger",
      "email": "stranger@example.com",
      "emailVerified": true,
      "firstName": "Some",
      "lastName": "Stranger",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "stranger", "temporary": false }]
    }
  ]
}
